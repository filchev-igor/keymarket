# Copy to .env.testing (gitignored) and fill in a SEPARATE Postgres database used only by tests.
# Tests wipe this database (RefreshDatabase): never point it at the production database.
# tests/Support/ProductionDatabaseGuard refuses to run when it looks like the same database as backend/.env.
APP_NAME=keymarket-test
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
FRONTEND_URL=http://localhost:5173

# Second Supabase project, Session pooler connection (host, user postgres.<test-project-ref>, password)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

BCRYPT_ROUNDS=4
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
LOG_CHANNEL=stderr
