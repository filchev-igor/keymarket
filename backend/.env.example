APP_NAME=keymarket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Comma-separated list of frontend origins allowed by CORS
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Supabase Postgres (copy values from Project Settings > Database > Connection string)
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# The API is stateless (token auth), so nothing needs the database for these
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
